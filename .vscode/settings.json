{
  // Practice repo: no autocomplete, so the answer never appears before you do.
  // These apply only to this folder -- your global VS Code setup is untouched.
  // Need a hint anyway? Ctrl+Space still opens suggestions on demand.

  // Terminal / Problems / Output panel on the right instead of the bottom.
  // A position already stored for this window wins over this setting, so run
  // "View: Move Panel Right" once (Ctrl+Shift+P) if it does not move by itself.
  "workbench.panel.defaultLocation": "right",

  "editor.quickSuggestions": {
    "other": false,
    "comments": false,
    "strings": false
  },
  "editor.suggestOnTriggerCharacters": false,
  "editor.wordBasedSuggestions": "off",
  "editor.inlineSuggest.enabled": false,
  "editor.parameterHints.enabled": false,
  "editor.snippetSuggestions": "none",
  "editor.tabCompletion": "off",
  "editor.acceptSuggestionOnEnter": "off",
  "editor.suggest.preview": false,
  "python.analysis.autoImportCompletions": false,

  // Repeated inside the language block: a language-specific setting always
  // wins over a general one, and your user settings already define [python].
  "[python]": {
    "editor.quickSuggestions": {
      "other": false,
      "comments": false,
      "strings": false
    },
    "editor.suggestOnTriggerCharacters": false,
    "editor.wordBasedSuggestions": "off",
    "editor.inlineSuggest.enabled": false,
    "editor.parameterHints.enabled": false,
    "editor.snippetSuggestions": "none",
    "editor.tabCompletion": "off",
    "editor.acceptSuggestionOnEnter": "off",

    // kept from your user settings so black-on-save still works
    "editor.defaultFormatter": "ms-python.black-formatter",
    "editor.formatOnSave": true
  }
}
